{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://interframe.dev/schemas/issue.v1.json",
  "title": "InterframeIssueContractV1",
  "description": "Issue and finding contract for Interframe continuity QA.",
  "type": "object",
  "required": [
    "issue_id",
    "project_hash",
    "engine_version",
    "sequence_id",
    "sequence_path",
    "shot_id",
    "frame_time",
    "actor_guid",
    "asset_path",
    "rule_id",
    "issue_type",
    "rule_version",
    "model_version",
    "severity",
    "confidence",
    "status",
    "observation",
    "one_sentence_explanation",
    "expected_state",
    "actual_state",
    "evidence_uri",
    "supporting_evidence",
    "engine_project_revision",
    "collector_version",
    "reviewer_status",
    "reviewer_disposition",
    "first_seen_build",
    "run_id"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "minLength": 6
    },
    "project_hash": {
      "type": "string",
      "minLength": 8
    },
    "engine_version": {
      "type": "string"
    },
    "sequence_id": {
      "type": "string"
    },
    "sequence_path": {
      "type": "string"
    },
    "shot_id": {
      "type": "string"
    },
    "frame_time": {
      "type": "object",
      "required": [
        "frame",
        "seconds"
      ],
      "properties": {
        "frame": {
          "type": "integer"
        },
        "seconds": {
          "type": "number"
        }
      }
    },
    "actor_guid": {
      "type": "string"
    },
    "actor_label": {
      "type": "string"
    },
    "asset_path": {
      "type": "string"
    },
    "rule_id": {
      "type": "string",
      "enum": [
        "IF-001",
        "IF-002",
        "IF-003",
        "IF-004",
        "IF-005",
        "IF-006",
        "IF-007",
        "IF-008"
      ]
    },
    "issue_type": {
      "type": "string"
    },
    "rule_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Critical",
        "Major",
        "Minor",
        "Informational"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "confidence_band": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Candidate / Needs Review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "failed",
        "needs_review",
        "configuration_warning"
      ]
    },
    "observation": {
      "type": "string"
    },
    "one_sentence_explanation": {
      "type": "string"
    },
    "expected_state": {
      "type": "object"
    },
    "actual_state": {
      "type": "object"
    },
    "evidence_uri": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "object",
      "properties": {
        "detection_source": {
          "type": "string",
          "enum": [
            "deterministic_engine_rule",
            "hybrid_metadata_plus_cv",
            "cv_only"
          ]
        },
        "rgb_frame_uri": {
          "type": "string"
        },
        "reference_frame_uri": {
          "type": "string"
        },
        "object_id_mask_uri": {
          "type": "string"
        },
        "visual_metrics": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "engine_project_revision": {
      "type": "string"
    },
    "collector_version": {
      "type": "string"
    },
    "reviewer_status": {
      "type": "string",
      "enum": [
        "true_positive",
        "false_positive",
        "intentional_change",
        "unresolved"
      ]
    },
    "reviewer_disposition": {
      "type": "object",
      "required": [
        "decision",
        "reviewer_id",
        "updated_at",
        "notes"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "true_positive",
            "false_positive",
            "intentional_change",
            "unresolved"
          ]
        },
        "reviewer_id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "first_seen_build": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    }
  }
}
